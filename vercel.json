{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/groq/chat/completions",
            "destination": "/api/groq/chat/completions"
        },
        {
            "source": "/api/groq/(.*)",
            "destination": "/api/groq"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}