# TalentAI - Environment Variables Template
# Copy this file to .env and add your real keys
# DO NOT commit your real .env file to GitHub

# Groq API Key (v1 compatible)
# Get yours at: https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# GitHub Token (Raises rate limit from 60 to 5,000 req/hr)
# Get yours at: https://github.com/settings/tokens/new
VITE_GITHUB_TOKEN=your_github_token_here
